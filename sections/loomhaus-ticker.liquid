<style>
  #shopify-section-{{ section.id }} {
    background: #777A67;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .lh-ticker {
    width: 100%;
    overflow: hidden;
    background: #777A67;
    padding: 16px 0;
    user-select: none;
    -webkit-user-select: none;
    display: flex;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .lh-ticker__track {
    display: flex;
    width: max-content;
    align-items: center;
    animation: lh-ticker-scroll-{{ section.id }} 38s linear infinite;
    will-change: transform;
  }

  #shopify-section-{{ section.id }} .lh-ticker:hover .lh-ticker__track {
    animation-play-state: paused;
  }

  #shopify-section-{{ section.id }} .lh-ticker__group {
    display: flex;
    flex-shrink: 0;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .lh-ticker__group span {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    color: #FFFFFF;
    font-family: Cabin;
    font-weight: 600;
    font-size: 17px;
    line-height: 100%;
    letter-spacing: 0%;
    padding: 0 18px;
  }

  #shopify-section-{{ section.id }} .lh-ticker__group b {
    display: inline-block;
    color: #EAE5DC;
    font-size: 13px;
    font-weight: normal;
    line-height: 1;
    margin-left: 36px;
    transform: scale(0.9);
  }

  @keyframes lh-ticker-scroll-{{ section.id }} {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .lh-ticker {
      padding: 12px 0;
    }

    #shopify-section-{{ section.id }} .lh-ticker__group span {
      
      padding: 0 12px;
font-weight: 600;
font-size: 14px;
line-height: 100%;
letter-spacing: 0%;

    }

    #shopify-section-{{ section.id }} .lh-ticker__group b {
      font-size: 11px;
      margin-left: 24px;
    }

    #shopify-section-{{ section.id }} .lh-ticker__track {
      animation-duration: 26s;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .lh-ticker__track {
      animation: none;
      transform: none;
    }
  }
</style>

