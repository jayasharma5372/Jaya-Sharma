<footer class="lh-footer" id="lh-footer-{{ section.id }}">
  <div class="lh-footer__inner page-width">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'brand' %}
          <div class="lh-footer__brand-col" {{ block.shopify_attributes }}>
            {% if block.settings.logo != blank %}
              {{ block.settings.logo | image_url: width: 300 | image_tag: class: 'lh-footer__logo', loading: 'lazy', alt: shop.name }}
            {% else %}
              <h2 class="lh-footer__brand-title">{{ block.settings.brand_title | default: shop.name }}</h2>
            {% endif %}

            {% if block.settings.tagline != blank %}
              <p class="lh-footer__tagline">{{ block.settings.tagline | escape }}</p>
            {% endif %}
          </div>

        {% when 'menu' %}
          <div class="lh-footer__menu-col" {{ block.shopify_attributes }}>
            {% if block.settings.heading != blank %}
              <h3 class="lh-footer__menu-title">{{ block.settings.heading | escape }}</h3>
            {% endif %}

            {% if block.settings.menu != blank %}
              <ul class="lh-footer__menu-list" role="list">
                {% for link in block.settings.menu.links %}
                  <li>
                    <a href="{{ link.url }}">{{ link.title }}</a>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>
      {% endcase %}
    {% endfor %}
  </div>
</footer>

<style>
@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

/* Section Background */
#shopify-section-{{ section.id }} {
  background-color: #242521 !important;
  width: 100%;
}

.lh-footer {
  background-color: #242521;
  color: #FFFFFF;
  padding: 56px 0 56px;
  width: 100%;
  font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* Grid Layout for Blocks */
.lh-footer__inner {
  display: flex;
  align-items: flex-start;
  margin: 0 auto;
  gap: clamp(40px, 6vw, 100px);
      justify-content: space-between;
}

/* 1. Brand Block */
.lh-footer__brand-col {
  flex: 1 1 45%;
  max-width: 480px;
}

.lh-footer__brand-title {
  margin: 0 0 16px;
  font-size: 34px;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: #ECE8DE;
  line-height: 1;
}

.lh-footer__logo {
  max-width: 180px;
  height: auto;
  display: block;
  margin-bottom: 16px;
}

.lh-footer__tagline {
  margin: 0;
  color: #fff;
  font-family: Cabin;
    font-weight: 400;
    font-size: 14px;
    line-height: 100%;
    letter-spacing: 0%;
}

/* 2. Menu Blocks */
.lh-footer__menu-col {
  flex: 0 0 auto;
}


.lh-footer__menu-title {
  margin: 0 0 10px;
      text-transform: uppercase;
    color: #E4DED3;
    font-family: Cabin;
    font-weight: 700;
    font-size: 13px;
    line-height: 100%;
    letter-spacing: 6%;
}

.lh-footer__menu-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.lh-footer__menu-list a {
  color: #fff;
  text-decoration: none;
    transition: color 0.15s ease;
    font-family: Cabin;
    font-weight: 400;
    font-size: 14px;
    line-height: 100%;
    letter-spacing: 0%;
}

.lh-footer__menu-list a:hover {
  color: #FFFFFF;
}

/* ==========================================================
   MOBILE VIEW (Matches Screenshot Exactly)
   ========================================================== */
@media screen and (max-width: 749px) {
  .lh-footer {
    padding: 36px 20px 36px;
  }

  .lh-footer__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 20px 0;
    padding:0 !important;
  }

  /* Brand spans full width on top */
  .lh-footer__brand-col {
    flex: 0 0 100%;
    max-width: 100%;
  }

  .lh-footer__brand-title {
    font-size: 32px;
    margin-bottom: 20px;
    font-family: Bricolage Grotesque;
font-weight: 800;
font-size: 26px;
line-height: 100%;
letter-spacing: 0%;

  }

  .lh-footer__tagline {
    font-family: Cabin;
font-weight: 400;
font-size: 13px;
line-height: 100%;
letter-spacing: 0%;

  }

  /* Reset margin on mobile */
  .lh-footer__brand-col + .lh-footer__menu-col {
    margin-left: 0;
  }

  /* Menu blocks sit side-by-side (2 columns) */
  .lh-footer__menu-col {
    flex: 0 0 50%;
    min-width: unset;
  }

  .lh-footer__menu-title {
    font-size: 13px;
    margin-bottom: 5px;
    letter-spacing: 0.1em;
    font-family: Cabin;
font-weight: 700;
font-size: 13px;
line-height: 100%;
letter-spacing: 6%;

  }

  .lh-footer__menu-list {
    gap: 0px;
  }

  .lh-footer__menu-list a {
    font-size: 15px;
    font-family: Cabin;
font-weight: 400;
font-size: 14px;
line-height: 100%;
letter-spacing: 0%;

  }
}
</style>

{% schema %}
{
  "name": "Loomhaus Footer",
  "blocks": [
    {
      "type": "brand",
      "name": "Brand & Tagline",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "brand_title",
          "label": "Brand Title",
          "default": "Loomhaus"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo Image (Optional)"
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "Brand Tagline",
          "default": "Clothes made to be worn for years, not seasons."
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "SHOP"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Select Menu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Loomhaus Footer",
      "blocks": [
        {
          "type": "brand"
        },
        {
          "type": "menu",
          "settings": {
            "heading": "SHOP"
          }
        },
        {
          "type": "menu",
          "settings": {
            "heading": "HELP"
          }
        }
      ]
    }
  ]
}
{% endschema %}