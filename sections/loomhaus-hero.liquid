{% assign hero_image = section.settings.image %}
<section class="lh-hero page-width">
  <div class="lh-hero__copy">
    {% if section.settings.eyebrow != blank %}<p class="lh-hero__badge">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h1>{{ section.settings.heading | escape }}</h1>
    <div class="lh-hero__description">{{ section.settings.description }}</div>
    {% if section.settings.button_label != blank %}
      <a class="lh-button lh-button--{{ section.settings.button_style | default: 'primary' }}" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
        <span>{{ section.settings.button_label | escape }}</span><span class="lh-button__arrow" aria-hidden="true"><svg width="20" height="12" viewBox="0 0 20 12" fill="none" xmlns="http://www.w3.org/2000/svg">
<g clip-path="url(#clip0_179_74)">
<path d="M0 6H18M13 11L18 6L13 1" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" stroke="white"/>
</g>
<defs>
<clipPath id="clip0_179_74">
<rect width="20" height="12" fill="white"/>
</clipPath>
</defs>
</svg>
</span>
      </a>
    {% endif %}
    <div class="lh-proof">
      <div><strong>{{ section.settings.stat_one_value | escape }}</strong><span>{{ section.settings.stat_one_label | escape }}</span></div>
      <div><strong>{{ section.settings.stat_two_value | escape }}</strong><span>{{ section.settings.stat_two_label | escape }}</span></div>
      <div><strong>{{ section.settings.stat_three_value | escape }}</strong><span>{{ section.settings.stat_three_label | escape }}</span></div>
    </div>
  </div>
  <div class="lh-hero__visual">
    <div class="lh-hero__shape" aria-hidden="true"></div>
    {% if hero_image != blank %}
      {{ hero_image | image_url: width: 1800 | image_tag: class: 'lh-hero__photo', loading: 'eager', widths: '600, 900, 1200, 1600, 1800', sizes: '(min-width: 990px) 42vw, 100vw', alt: section.settings.image_alt, fetchpriority: 'high' }}
    {% else %}
      <div class="lh-hero__placeholder">ADD YOUR WINTER CAMPAIGN IMAGE</div>
    {% endif %}
    {% assign selected_product = section.settings.featured_product %}

{% if selected_product != blank %}
  <a href="{{ selected_product.url }}" class="lh-hero__product">
    {% if selected_product.featured_image != blank %}
      {{
        selected_product.featured_image
        | image_url: width: 120
        | image_tag:
          loading: 'lazy',
          alt: selected_product.title
        }}
    {% endif %}

    <div>
      <strong>{{ selected_product.title | escape }}</strong>
      <small>{{ section.settings.product_subtitle | escape }}</small>
    </div>
  </a>
{% endif %}
  </div>
</section>
<style>
@import url('https://fonts.googleapis.com/css2?family=Cabin:wght@700&display=swap');

#shopify-section-{{ section.id }}{
  background: #F6F3ED;
  overflow: hidden;
}

/* Base Hero Layout */
.lh-hero {
  --lh-ink: #292a26;
  --lh-muted: #77786f;
  position: relative;
  isolation: isolate;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  align-items: center;
  column-gap: clamp(32px, 5vw, 60px);
  width: 100%;
  padding-top: clamp(48px, 6vw, 72px);
  padding-bottom: clamp(56px, 7vw, 80px);
  background: transparent;
  color: var(--lh-ink);
  box-sizing: border-box;
}

.lh-hero__copy {
  position: relative;
  z-index: 2;
      padding-right: 96px;
}

.lh-hero__badge {
  display: inline-flex;
  align-items: center;
  margin: 0 0 26px;
  color: #fff;
  text-transform: uppercase;
  border-radius: 999px;
  padding: 6px 14px;
  background: #777A67;
  font-family: Lilita One;
  font-weight: 400;
  font-size: 14px;
  line-height: 100%;
  letter-spacing: 4%;
}

.lh-hero h1 {
  margin: 0 0 20px;
  color: #292A26;
  font-family: Bricolage Grotesque;
  font-weight: 800;
  font-size: 88px;
  line-height: 95%;
  letter-spacing: -2%;
}

.lh-hero__description {
  color: #706F68;
  font-family: Cabin;
  font-weight: 400;
  font-size: 18px;
  line-height: 150%;
  letter-spacing: 0%;
}

.lh-hero__description p {
  margin: 0;
}

/* Base Button Layout */
.lh-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding-top: 14px;
  padding-right: 28px;
  padding-bottom: 14px;
  padding-left: 28px;
  gap: 12px;
  border-radius: 999px;
  text-decoration: none;
  text-transform: uppercase;
  font-family: 'Cabin', sans-serif;
  font-weight: 700;
  font-style: normal;
  font-size: 14px;
  line-height: 100%;
  letter-spacing: 0.06em;
  margin-top: 24px;
  border: none;
  cursor: pointer;
  transition: background-color .2s ease, transform .2s ease, box-shadow .2s ease, opacity .2s ease;
}

.lh-button__arrow {
  display: inline-block;
  font-size: 16px;
  line-height: 1;
  transition: transform .25s ease;
}

/* Primary Button */
.lh-button--primary {
  background: #292A26;
  color: #FFFFFF;
}

.lh-button--primary:hover {
  background: #777A67;
  color: #FFFFFF;
}

/* Secondary Button */
.lh-button--secondary {
  background: #E4DED3;
  color: #292A26;
}

.lh-button--secondary:hover {
  background: #D8D2C7;
  color: #292A26;
}

/* Disabled State */
.lh-button:disabled,
.lh-button.disabled,
.lh-button[aria-disabled="true"] {
  background: #292A26 !important;
  opacity: 0.4 !important;
  cursor: not-allowed;
  pointer-events: none;
  transform: none !important;
  box-shadow: none !important;
}

.lh-button:hover .lh-button__arrow {
  transform: translateX(4px);
}

.lh-proof {
  display: flex;
  align-items: flex-start;
  gap: clamp(24px, 3.5vw, 40px);
  margin-top: 46px;
}

.lh-proof div {
  display: grid;
  gap: 4px;
}

.lh-proof strong {
  color: #292a26;
  white-space: nowrap;
      font-family: Bricolage Grotesque;
    font-weight: 700;
    font-size: 26px;
    line-height: 100%;
    letter-spacing: 0%;
}

.lh-proof span {
  color: #706F68;
  white-space: nowrap;
      font-family: Cabin;
    font-weight: 400;
    font-size: 13px;
    line-height: 100%;
    letter-spacing: 0%;
}

/* Visual Container - Fixed Overlap */
.lh-hero__visual {
  position: relative;
  justify-self: center;
  width: 100%;
  max-width: 480px;
  aspect-ratio: 1 / 1.15;
  isolation: isolate;
  display: flex;
  align-items: flex-end;
      margin-top: -5px;
  justify-content: flex-start;
}

/* Circular back drop - properly bound inside visual */
.lh-hero__visual:before {
  content: '';
  position: absolute;
  width: 105%;
  height:91%;
  aspect-ratio: 1;
  border-radius: 50%;
  background: #E4DED3;
  right: -5%;
  bottom: 0%;
  z-index: 0;
  pointer-events: none;
}

.lh-hero__shape {
  display: none;
}

/* Lifestyle Image: arched top, contained height */
.lh-hero__photo {
  position: relative;
  z-index: 1;
  display: block;
  width: 92%;
  height: 98%;
  object-fit: cover;
  object-position: center;
  border-radius: 24px;
  margin: 0;
}

.lh-hero__placeholder {
  position: relative;
  z-index: 1;
  display: grid;
  place-items: center;
  width: 88%;
  height: 98%;
  border-radius: 260px 260px 24px 24px;
  background: linear-gradient(145deg, #e6dfd1, #c5c3b5);
  color: #45483d;
  font-size: 11px;
  letter-spacing: .15em;
  text-align: center;
}

/* Floating Product Pill */
.lh-hero__product {
  position: absolute;
  z-index: 3;
  left: -12%;
  bottom: 13%;
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 170px;
  padding: 12px 16px;
  border-radius: 16px;
  background: #fff;
  box-shadow: 0px 8px 24px 0px #0000001F;
  text-decoration: none !important;
  color: #292a26 !important;
  cursor: pointer;
  border: 0;
  transition: transform .25s ease, box-shadow .25s ease;
}

.lh-hero__product:hover {
  transform: translateY(-3px);
  box-shadow: 0 14px 30px rgba(39, 39, 31, 0.18);
}

.lh-hero__product > img {
  width: 36px;
  height: 36px;
  object-fit: cover;
  border-radius: 50%;
  display: block;
}

.lh-hero__product > div {
  display: grid;
  gap: 2px;
}

.lh-hero__product strong {
  color: #292A26;
  font-family: Cabin;
    font-weight: 700;
    font-size: 14px;
    line-height: 100%;
    letter-spacing: 0%;
}

.lh-hero__product small {
  color: #706F68;
  font-family: Cabin;
    font-weight: 400;
    font-size: 12px;
    line-height: 100%;
    letter-spacing: 0%;
}

/* Medium Screens Tablet */
@media (max-width: 989px) {
  .lh-hero {
    column-gap: 24px;
    padding-top: 48px;
    padding-bottom: 56px;
  }
  .lh-hero h1 {
    font-size: 54px;
  }
  .lh-hero__visual {
    max-width: 400px;
  }
  .lh-hero__product {
    left: 0;
  }
  .lh-hero__copy {
    padding-right: 0;
}
}

/* Mobile View */
@media (max-width: 749px) {
  .lh-hero {
    display: flex;
    flex-direction: column;
    padding-top: 32px;
    padding-bottom: 50px;
    gap: 0;
  }

  .lh-hero__copy {
    max-width: 100%;
    width: 100%;
  }

  .lh-hero__badge {
    margin: 0 0 18px;
    font-size: 12px;
    padding: 6px 14px;
    background: #777A67;
  }

  .lh-hero h1 {
    font-size: 52px;
    line-height: 0.95;
    margin: 0 0 18px;
font-weight: 800;
line-height: 95%;
letter-spacing: -2%;

  }

  .lh-hero__description {
    max-width: 100%;
    font-size: 16px;
    line-height: 1.45;
    margin-bottom: 18px;
font-weight: 400;
line-height: 150%;
letter-spacing: 0%;

  }

  .lh-button {
    display: flex;
    width: 100%;
    height: 45px;
    margin-top: 0;
    justify-content: center;
    box-sizing: border-box;
font-weight: 700;
font-style: Bold;
font-size: 14px;
line-height: 100%;
letter-spacing: 6%;

  }

  .lh-proof {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 18px 0;
    gap: 8px;
    text-align: left;
  }

  .lh-proof strong {
    font-size: 26px;
  }

  .lh-proof span {
    font-size: 13px;
  }

  .lh-hero__visual {
    width: 100%;
    max-width: 340px;
    margin: 0 auto;
    aspect-ratio: 4 / 4.9;
    justify-self: center;
  }

  .lh-hero__visual:before {
    width: 260px;
    height: 260px;
    right: -20px;
    bottom: 5%;
  }

  .lh-hero__photo,
  .lh-hero__placeholder {
    width: 100%;
    height: 100%;
    border-radius: 200px 200px 20px 20px;
  }

  .lh-hero__product {
    display: none !important;
  }
}

@media (prefers-reduced-motion: reduce) {
  .lh-button, .lh-button__arrow {
    transition: none;
  }
}
</style>
{% schema %}
{
  "name": "Loomhaus hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Badge",
      "default": "NEW SEASON · AUTUMN / WINTER"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Winter Edit"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Warm layers, honest fabrics and fits that work every day. Discover the pieces our community wears on repeat this season.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Shop button label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Shop button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button Style",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        }
      ],
      "default": "primary"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero lifestyle image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Loomhaus autumn winter collection"
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "Select featured product"
    },
    {
      "type": "text",
      "id": "product_subtitle",
      "label": "Product note",
      "default": "Bestseller this week"
    },
    {
      "type": "text",
      "id": "stat_one_value",
      "label": "Stat 1 value",
      "default": "4.8★"
    },
    {
      "type": "stat_one_label",
      "id": "stat_one_label",
      "type": "text",
      "label": "Stat 1 label",
      "default": "2,000+ reviews"
    },
    {
      "type": "text",
      "id": "stat_two_value",
      "label": "Stat 2 value",
      "default": "100%"
    },
    {
      "type": "text",
      "id": "stat_two_label",
      "label": "Stat 2 label",
      "default": "Organic cotton"
    },
    {
      "type": "text",
      "id": "stat_three_value",
      "label": "Stat 3 value",
      "default": "30 days"
    },
    {
      "type": "text",
      "id": "stat_three_label",
      "label": "Stat 3 label",
      "default": "Free returns"
    }
  ],
  "presets": [
    {
      "name": "Loomhaus hero"
    }
  ]
}
{% endschema %}